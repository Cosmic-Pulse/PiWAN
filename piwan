#!/bin/bash
set -e

# Determine project root directory (where this script resides)
PROJECT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$PROJECT_DIR"
SERVICE_NAME=piwan
SYSTEMD_SERVICE_FILE=/etc/systemd/system/${SERVICE_NAME}.service

# Compose reads these for ${...} in docker-compose.yml; env_file values don't count there.
# gateway.conf lines can carry a trailing comment, so strip it.
BASICSTATION_PLATFORM=$(grep -E '^BASICSTATION_PLATFORM=' gateway.conf | cut -d= -f2 | sed 's/#.*//' | tr -d ' ' || true)
export BASICSTATION_PLATFORM=${BASICSTATION_PLATFORM:-rpi}
DOCKER_GID=$(getent group docker | cut -d: -f3)
export DOCKER_GID=${DOCKER_GID:-0}

install_service() {
  echo "[Unit]"
  echo "Description=PiWAN Service"
  echo "After=network.target docker.service"
  echo "[Service]"
  echo "Type=oneshot"
  echo "RemainAfterExit=yes"
  echo "WorkingDirectory=$PROJECT_DIR"
  echo "ExecStart=/usr/local/bin/piwan up"
  echo "ExecStop=/usr/local/bin/piwan down"
  echo "[Install]"
  echo "WantedBy=multi-user.target"
}

case "$1" in
  build)
    echo "Building for platform: $BASICSTATION_PLATFORM"
    docker compose build basicstation
    ;;
  up)
    docker compose up -d
    ;;
  down)
    docker compose down
    ;;
  logs)
    if [ -n "$2" ]; then
      docker logs --tail 50 -f "$2"
    else
      docker compose logs -f
    fi
    ;;
  install)
    echo "Building containers..."
    "$0" build
    echo "Writing wrapper to /usr/local/bin/piwan..."
    sudo tee /usr/local/bin/piwan > /dev/null <<EOF
#!/bin/bash
cd "$PROJECT_DIR"
exec "$PROJECT_DIR/$(basename "$0")" "\$@"
EOF
    sudo chmod +x /usr/local/bin/piwan
    echo "Setting up systemd service..."
    install_service | sudo tee "$SYSTEMD_SERVICE_FILE" > /dev/null
    sudo systemctl daemon-reload
    sudo systemctl enable "$SERVICE_NAME"
    sudo systemctl start "$SERVICE_NAME"
    echo "Piwan installed and enabled to start on boot."
    ;;
  *)
    echo "Usage: $0 {build|up|down|logs [service]|install}"
    exit 1
    ;;
esac
